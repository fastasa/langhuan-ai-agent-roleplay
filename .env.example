# 琅嬛本地开源版只读取项目根目录下的 .env。
# 复制为 .env 后按需修改；不要把 .env 提交到 Git。

# 服务固定监听 127.0.0.1，只允许修改端口。
PORT=3217

# 首发默认使用本机 SQLite 数据库。未设置时文件位于 server/data/langhuan.db。
# LANGHUAN_DB_PATH=D:\path\to\langhuan.db

# 本地加密密钥。留空时首次启动会在 server/data/ 生成随机本机密钥。
# 如需迁移已有加密配置，可显式设置同一个稳定长随机值。
# LANGHUAN_LOCAL_SECRET=

# 默认不记录完整 AI 消息；排查时才临时设为 true。
AI_LOG_FULL_MESSAGES=false

# 可选第三方服务。留空时不会向对应提供商发送请求。
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# WEATHER_API_KEY=

# 可选本机 CLI 桥。它们只使用部署者自己的 CLI 登录状态。
# LANGHUAN_CODEX_CLI_PATH=
# LANGHUAN_CLAUDE_CLI_PATH=
